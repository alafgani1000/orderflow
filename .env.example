APP_NAME=OrderFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@orderflow.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# OrderFlow business identity and customer support
ORDERFLOW_COMPANY_NAME="OrderFlow"
ORDERFLOW_COMPANY_LEGAL_NAME=""
ORDERFLOW_SUPPORT_EMAIL="support@orderflow.id"
ORDERFLOW_SUPPORT_PHONE=""
ORDERFLOW_BILLING_PHONE=""

# Billing destination accounts (leave blank until verified)
ORDERFLOW_BCA_ACCOUNT=""
ORDERFLOW_BCA_ACCOUNT_HOLDER=""
ORDERFLOW_MANDIRI_ACCOUNT=""
ORDERFLOW_MANDIRI_ACCOUNT_HOLDER=""
ORDERFLOW_QRIS_ENABLED=false

# Increment these values whenever the published legal documents change
ORDERFLOW_TERMS_VERSION="2026-09-20"
ORDERFLOW_PRIVACY_VERSION="2026-09-20"

# Private storage, backup, health monitoring, and security
ORDERFLOW_PRIVATE_DISK=local
ORDERFLOW_BACKUP_PATH=
ORDERFLOW_BACKUP_RETENTION_DAYS=14
ORDERFLOW_BACKUP_INCLUDE_FILES=true
ORDERFLOW_HEALTH_TOKEN=
ORDERFLOW_FORCE_HTTPS=false
